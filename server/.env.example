# Ultimate Sensor Monitor Reimagined - Backend Environment Variables
#
# Copy this file to `.env` and adjust values as needed.
# All variables use the ULTIMON_ prefix (set in app/config.py).
# Pydantic BaseSettings reads from environment variables and this .env file.

# --- Server settings ---
ULTIMON_APP_NAME="Ultimate Sensor Monitor Reimagined"
ULTIMON_DEBUG=false
ULTIMON_HOST=0.0.0.0
ULTIMON_PORT=8100

# --- CORS settings ---
# Comma-separated list of allowed origins.
ULTIMON_CORS_ORIGINS=["http://localhost:5501","http://localhost:5173","http://localhost:4173","http://localhost:3000"]

# --- WebSocket settings ---
# Seconds between sensor data broadcasts to WebSocket clients.
ULTIMON_SENSOR_UPDATE_INTERVAL=2.0
ULTIMON_MAX_WEBSOCKET_CONNECTIONS=100

# --- Data settings ---
ULTIMON_DATA_DIRECTORY=data
# Maximum preset size in bytes (default: 10MB = 10485760).
ULTIMON_MAX_PRESET_SIZE=10485760

# --- Sensor settings ---
# Mock sensor is opt-in only; enable for offline development/testing.
ULTIMON_MOCK_SENSOR_ENABLED=false
ULTIMON_AIDA64_ENABLED=false
ULTIMON_LIBRE_HARDWARE_MONITOR_ENABLED=true
ULTIMON_HWINFO_ENABLED=false
